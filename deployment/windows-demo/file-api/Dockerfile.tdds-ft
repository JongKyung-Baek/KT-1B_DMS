# syntax=docker/dockerfile:1.7

# Build this image with the clean TDDS-FT Git revision as the build context:
#   docker build -f <this-file> --build-arg TDDSFT_SOURCE_COMMIT=<commit> ...
FROM python:3.11-slim-bookworm

ARG TDDSFT_SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.title="TDDS-FT" \
      org.opencontainers.image.revision="${TDDSFT_SOURCE_COMMIT}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/tdds-ft

COPY requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY run_waitress.py ./run_waitress.py

RUN groupadd --gid 10002 tddsft \
    && useradd --uid 10002 --gid tddsft --create-home \
        --shell /usr/sbin/nologin tddsft \
    && mkdir -p /data/kt1b/files/.tdds-ft-tmp /var/log/tdds-ft \
    && chown -R tddsft:tddsft /data/kt1b /var/log/tdds-ft

USER tddsft

ENTRYPOINT ["python", "run_waitress.py"]
