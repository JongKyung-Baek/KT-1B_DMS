\set ON_ERROR_STOP on

\echo '[KT-1B] Applying extension tables used by the current application...'
\ir dxf_sub_file_ddl.sql
\ir production_sub_file_ddl.sql
\ir sw_sub_file_ddl.sql
\ir doc_approval_comment_ddl.sql
\ir drawing_approval_comment_ddl.sql
\ir dxf_approval_comment_ddl.sql
\ir production_approval_comment_ddl.sql
\ir sw_approval_comment_ddl.sql

\echo '[KT-1B] Applying user integrity, ACL, audit and download migrations...'
\ir organization_management_integrity_ddl.sql
\ir acl_foundation_ddl.sql
\ir distribution_workflow_ddl.sql
\ir audit_trail_ddl.sql
\ir download_runtime_ddl.sql

\echo '[KT-1B] Removing retired content and portal objects...'
\ir remove_unused_content_features_ddl.sql
\ir remove_orphan_legacy_objects_ddl.sql
\ir internal_only_cleanup_ddl.sql

\echo '[KT-1B] Converting retained application routes to /general...'
\ir general_route_migration_ddl.sql

\echo '[KT-1B] Applying viewer integration state and configuration cleanup...'
\ir viewer_integration_ddl.sql

\if :include_sample_data
\echo '[KT-1B] Replacing business data with the local demonstration data set...'
\ir sample_demo_data.sql
\else
\echo '[KT-1B] Sample data reset skipped.'
\endif

\echo '[KT-1B] Fresh database migration completed.'
