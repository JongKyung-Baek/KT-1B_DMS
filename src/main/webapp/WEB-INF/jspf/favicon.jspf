<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:choose>
  <c:when test="${tdmsBrand.alternate}">
    <link rel="icon" type="image/png" sizes="32x32"
          href="${pageContext.request.contextPath}/resources/images/brand/esobsoft-favicon-32x32.png?v=20260804.1" />
    <link rel="shortcut icon" type="image/x-icon"
          href="${pageContext.request.contextPath}/resources/images/brand/esobsoft-favicon.ico?v=20260804.1" />
    <link rel="apple-touch-icon" sizes="180x180"
          href="${pageContext.request.contextPath}/resources/images/brand/esobsoft-apple-touch-icon.png?v=20260804.1" />
  </c:when>
  <c:otherwise>
    <link rel="icon" type="image/png" sizes="32x32"
          href="${pageContext.request.contextPath}/resources/images/favicon/favicon-32x32.png?v=20260802.2" />
    <link rel="shortcut icon" type="image/x-icon"
          href="${pageContext.request.contextPath}/resources/images/favicon/favicon.ico?v=20260802.2" />
    <link rel="apple-touch-icon" sizes="180x180"
          href="${pageContext.request.contextPath}/resources/images/favicon/apple-touch-icon.png?v=20260802.2" />
  </c:otherwise>
</c:choose>
